<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>持物 ChiWu</title>
<script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.min.js"></script>
<script>
window.Vue = window.Vue || undefined;
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/element-plus/dist/index.min.css">
<style>
/* ===== CSS Variables ===== */
:root {
  --bg: #f5f5f7;
  --card-bg: #ffffff;
  --text: #1d1d1f;
  --text-secondary: #86868b;
  --border: #e5e5ea;
  --tab-bar: rgba(255,255,255,0.92);
  --primary: #3A7C6C;
  --primary-light: #4A9C8C;
  --danger: #ff3b30;
  --success: #34c759;
  --warning: #ff9500;
  --shadow: 0 2px 8px rgba(0,0,0,0.06);
}
html.dark {
  --bg: #1c1c1e;
  --card-bg: #2c2c2e;
  --text: #f5f5f7;
  --text-secondary: #98989d;
  --border: #38383a;
  --tab-bar: rgba(28,28,30,0.92);
  --shadow: 0 2px 8px rgba(0,0,0,0.3);
}
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg); color: var(--text);
  max-width: 480px; margin: 0 auto; min-height: 100vh;
  padding-bottom: 80px; position: relative;
}

/* ===== Tab Bar ===== */
.tab-bar {
  position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 100%; max-width: 480px;
  background: var(--tab-bar); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid var(--border);
  display: flex; justify-content: space-around; align-items: center;
  height: 64px; padding-bottom: 8px; z-index: 100;
}
.tab-item {
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  font-size: 10px; color: var(--text-secondary); cursor: pointer;
  padding: 6px 16px; border: none; background: none; transition: color 0.2s;
  -webkit-tap-highlight-color: transparent;
}
.tab-item.active { color: var(--primary); }
.tab-item .tab-icon { font-size: 22px; line-height: 1; }
.tab-item .tab-label { font-size: 10px; }

/* ===== Header ===== */
.page-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 20px 8px; position: sticky; top: 0; z-index: 10;
  background: var(--bg);
}
.page-header h1 { font-size: 28px; font-weight: 700; }
.page-header .header-actions { display: flex; gap: 12px; align-items: center; }

/* ===== Cards ===== */
.card {
  background: var(--card-bg); border-radius: 12px;
  box-shadow: var(--shadow); padding: 16px; margin: 0 16px 8px;
  transition: transform 0.15s;
}
.card:active { transform: scale(0.98); }

/* ===== Tags ===== */
.status-tag { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 500; }
.status-active { color: var(--success); background: rgba(52,199,89,0.12); }
.status-sold { color: var(--text-secondary); background: rgba(134,134,139,0.12); }
.status-discarded { color: var(--warning); background: rgba(255,149,0,0.12); }
.status-lost { color: var(--danger); background: rgba(255,59,48,0.12); }

/* ===== Price ===== */
.price { color: var(--primary); font-weight: 600; font-size: 15px; }
.price::before { content: '¥'; font-size: 12px; }

/* ===== Bottom Sheet Form ===== */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.sheet {
  position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 100%; max-width: 480px; max-height: 85vh; overflow-y: auto;
  background: var(--card-bg); border-radius: 16px 16px 0 0; z-index: 201;
  padding: 20px; animation: slideUp 0.3s ease;
}
@keyframes slideUp { from { transform: translateX(-50%) translateY(100%); } to { transform: translateX(-50%) translateY(0); } }
.sheet-handle { width: 36px; height: 4px; border-radius: 2px; background: var(--border); margin: 0 auto 16px; }
.sheet h2 { font-size: 18px; font-weight: 600; margin-bottom: 16px; }
.sheet .form-group { margin-bottom: 14px; }
.sheet .form-group label { display: block; font-size: 13px; color: var(--text-secondary); margin-bottom: 4px; }
.sheet .form-group input, .sheet .form-group select, .sheet .form-group textarea {
  width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px;
  font-size: 15px; background: var(--bg); color: var(--text); outline: none;
}
.sheet .form-group input:focus, .sheet .form-group select:focus { border-color: var(--primary); }

/* ===== Search Bar ===== */
.search-bar {
  margin: 0 16px 12px; position: relative;
}
.search-bar input {
  width: 100%; padding: 10px 16px 10px 36px; border: none; border-radius: 10px;
  font-size: 15px; background: var(--card-bg); color: var(--text); box-shadow: var(--shadow);
  outline: none;
}
.search-bar .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); font-size: 16px; }

/* ===== Animations ===== */
.fade-enter-active, .fade-leave-active { transition: opacity 0.2s; }
.fade-enter-from, .fade-leave-to { opacity: 0; }

/* ===== Detail View ===== */
.detail-view { position: absolute; inset: 0; background: var(--bg); z-index: 50; overflow-y: auto; padding-bottom: 80px; }
.detail-header { display: flex; align-items: center; padding: 12px 16px; gap: 12px; }
.detail-back { font-size: 24px; cursor: pointer; padding: 4px; border: none; background: none; color: var(--primary); }
.detail-title { font-size: 17px; font-weight: 600; }

/* ===== Empty State ===== */
.empty-state { text-align: center; padding: 60px 20px; color: var(--text-secondary); }
.empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; }
.empty-state p { font-size: 15px; }

/* ===== Loading ===== */
.loading { text-align: center; padding: 40px; color: var(--text-secondary); }

/* ===== Swipe action ===== */
.swipe-wrap { position: relative; overflow: hidden; }
.swipe-actions { position: absolute; right: 0; top: 0; height: 100%; display: flex; align-items: center; gap: 0; transform: translateX(100%); transition: transform 0.2s; }
.swipe-wrap.show-delete .swipe-actions { transform: translateX(0); }
.swipe-btn { height: 100%; display: flex; align-items: center; padding: 0 20px; font-size: 14px; color: #fff; border: none; cursor: pointer; }
.swipe-btn-danger { background: var(--danger); border-radius: 0 12px 12px 0; }

/* 03_detail.html */
/* ===== Detail Layout ===== */
.detail-section {
  margin: 8px 16px;
}
.detail-section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 8px;
  padding: 0 4px;
}

/* ===== Asset Name ===== */
.detail-asset-name {
  font-size: 22px;
  font-weight: 700;
  padding: 4px 20px;
  line-height: 1.3;
}
.detail-asset-meta {
  font-size: 13px;
  color: var(--text-secondary);
  padding: 0 20px 8px;
}

/* ===== Amount Card ===== */
.detail-amount-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
}
.detail-amount-item {
  text-align: center;
  padding: 12px 4px;
}
.detail-amount-item .label {
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}
.detail-amount-item .value {
  font-size: 16px;
  font-weight: 700;
  color: var(--primary);
}
.detail-amount-item .value.warn {
  color: var(--danger);
}
.detail-amount-item .value.success {
  color: var(--success);
}

/* ===== Holding Days ===== */
.detail-hold-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
}
.detail-hold-box .hold-left {
  display: flex;
  flex-direction: column;
}
.detail-hold-box .hold-days {
  font-size: 28px;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.1;
}
.detail-hold-box .hold-label {
  font-size: 12px;
  color: var(--text-secondary);
}
.detail-hold-box .hold-cost {
  text-align: right;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.detail-hold-box .hold-cost small {
  font-size: 11px;
  font-weight: 400;
  color: var(--text-secondary);
  display: block;
}

/* ===== Status Tag (detail) ===== */
.detail-status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 20px;
  margin-bottom: 8px;
}

/* ===== Notes ===== */
.detail-notes {
  font-size: 14px;
  color: var(--text);
  line-height: 1.5;
  white-space: pre-wrap;
  padding: 0 4px;
}

/* ===== Maintenance Timeline ===== */
.maint-list {
  list-style: none;
  padding: 0;
}
.maint-item {
  position: relative;
  padding: 12px 0 12px 20px;
  border-left: 2px solid var(--border);
  margin-left: 8px;
}
.maint-item::before {
  content: '';
  position: absolute;
  left: -5px;
  top: 18px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--primary);
}
.maint-item:last-child {
  border-left-color: transparent;
}
.maint-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.maint-item-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.maint-item-date {
  font-size: 11px;
  color: var(--text-secondary);
  margin-top: 2px;
}
.maint-item-amount {
  font-size: 14px;
  font-weight: 600;
  color: var(--danger);
}
.maint-item-amount::before {
  content: '¥';
  font-size: 11px;
}
.maint-item-note {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
  line-height: 1.4;
}
.maint-item-actions {
  margin-top: 6px;
  display: flex;
  gap: 8px;
}
.maint-delete-btn {
  font-size: 12px;
  color: var(--danger);
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px 6px;
  border-radius: 4px;
}
.maint-delete-btn:hover {
  background: rgba(255,59,48,0.1);
}
.maint-empty {
  text-align: center;
  padding: 24px 0;
  color: var(--text-secondary);
  font-size: 13px;
}

/* ===== Detail Edit Button ===== */
.detail-edit-btn-wrap {
  padding: 16px 20px 24px;
}
.detail-edit-btn {
  display: block;
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 12px;
  background: var(--primary);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  text-align: center;
  transition: opacity 0.2s;
}
.detail-edit-btn:active {
  opacity: 0.8;
}

/* ===== Loading in detail ===== */
.detail-loading {
  text-align: center;
  padding: 40px;
  color: var(--text-secondary);
  font-size: 14px;
}

/* 05_stats.html */
/* ===== Stats Module Styles ===== */
#stats-placeholder {
  padding: 20px;
  color: #e0e0e0;
  font-family: 'Segoe UI', system-ui, sans-serif;
}

/* --- Overview Cards (2x2 grid) --- */
.stats-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 28px;
}
.stats-overview-card {
  background: #1e2a3a;
  border-radius: 12px;
  padding: 16px 18px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.stats-overview-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.35);
}
.stats-overview-card .label {
  font-size: 12px;
  color: #8899aa;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  margin-bottom: 6px;
}
.stats-overview-card .value {
  font-size: 24px;
  font-weight: 700;
  color: #ffffff;
}
.stats-overview-card .sub {
  font-size: 13px;
  color: #6b8aa0;
  margin-top: 4px;
}
.stats-overview-card .sub strong {
  color: #7ecfff;
}
.stats-overview-card.highlight {
  border-left: 3px solid #4fc3f7;
}
.stats-overview-card.highlight-green {
  border-left: 3px solid #66bb6a;
}
.stats-overview-card.highlight-amber {
  border-left: 3px solid #ffb74d;
}
.stats-overview-card.highlight-purple {
  border-left: 3px solid #ab47bc;
}

/* --- Section headers --- */
.stats-section-title {
  font-size: 16px;
  font-weight: 600;
  color: #c0d0e0;
  margin: 24px 0 14px 0;
  padding-bottom: 6px;
  border-bottom: 1px solid #2a3a4a;
}

/* --- Category Distribution Donut --- */
.stats-donut-container {
  display: flex;
  align-items: center;
  gap: 28px;
  padding: 14px 0;
  flex-wrap: wrap;
}
.stats-donut-ring {
  position: relative;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  flex-shrink: 0;
}
.stats-donut-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: #1a2535;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #8899aa;
}
.stats-donut-center .num {
  font-size: 22px;
  font-weight: 700;
  color: #e0e0e0;
}
.stats-donut-center .lbl {
  font-size: 11px;
}
.stats-donut-legend {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 140px;
}
.stats-donut-legend-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #c0d0e0;
}
.stats-donut-legend-item .color-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
}
.stats-donut-legend-item .pct {
  margin-left: auto;
  color: #8899aa;
  font-size: 12px;
}

/* --- Daily Cost Ranking --- */
.stats-cost-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.stats-cost-item {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  border-bottom: 1px solid #253040;
  gap: 12px;
  transition: background 0.1s;
}
.stats-cost-item:hover {
  background: #1f2c3e;
  border-radius: 6px;
}
.stats-cost-item .rank {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #283548;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #7ecfff;
  flex-shrink: 0;
}
.stats-cost-item .rank.top1 { background: #ffd700; color: #1a1a1a; }
.stats-cost-item .rank.top2 { background: #c0c0c0; color: #1a1a1a; }
.stats-cost-item .rank.top3 { background: #cd7f32; color: #1a1a1a; }
.stats-cost-item .cost-name {
  flex: 1;
  font-size: 14px;
  color: #d0e0f0;
}
.stats-cost-item .cost-daily {
  font-size: 14px;
  font-weight: 600;
  color: #ff8a65;
  width: 80px;
  text-align: right;
}
.stats-cost-item .cost-tco {
  font-size: 12px;
  color: #6b8aa0;
  width: 100px;
  text-align: right;
}

/* --- Monthly Trend Bar Chart --- */
.stats-trend-chart {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px 0;
}
.stats-trend-bar-row {
  display: flex;
  align-items: center;
  gap: 10px;
}
.stats-trend-bar-label {
  width: 70px;
  font-size: 13px;
  color: #8899aa;
  text-align: right;
  flex-shrink: 0;
}
.stats-trend-bar-track {
  flex: 1;
  height: 22px;
  background: #1a2535;
  border-radius: 4px;
  overflow: hidden;
  position: relative;
}
.stats-trend-bar-fill {
  height: 100%;
  border-radius: 4px;
  background: linear-gradient(90deg, #4fc3f7, #29b6f6);
  transition: width 0.5s ease;
  display: flex;
  align-items: center;
  padding-left: 6px;
}
.stats-trend-bar-fill .bar-count {
  font-size: 11px;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 1px 2px rgba(0,0,0,0.4);
  white-space: nowrap;
}
.stats-trend-bar-count {
  width: 36px;
  font-size: 13px;
  font-weight: 600;
  color: #b0c8e0;
  text-align: right;
  flex-shrink: 0;
}

/* --- Empty State --- */
.stats-empty {
  text-align: center;
  padding: 40px 20px;
  color: #6b8aa0;
  font-size: 15px;
}
.stats-empty .icon {
  font-size: 40px;
  margin-bottom: 12px;
  opacity: 0.5;
}

/* --- Loading --- */
.stats-loading {
  text-align: center;
  padding: 40px;
  color: #6b8aa0;
}

/* 06_wishes.html */
#wishes-module .wishes-loading,
#wishes-module .wishes-empty,
#wishes-module .wishes-error {
  padding: 40px 16px;
  text-align: center;
  color: var(--text-muted, #888);
}
#wishes-module .wishes-error { color: #e74c3c; }

.wish-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: var(--card-bg, #fff);
  border-radius: 10px;
  padding: 14px 16px;
  margin: 0 0 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
  transition: opacity .25s;
}
.wish-card--done {
  opacity: 0.45;
}
.wish-card__body { flex: 1; min-width: 0; }
.wish-card__name {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}
.wish-card__meta {
  display: flex;
  gap: 12px;
  font-size: 14px;
  color: var(--text-muted, #888);
}
.wish-card__price { color: var(--accent, #e67e22); font-weight: 600; }
.wish-card__note {
  margin-top: 6px;
  font-size: 13px;
  color: var(--text-muted, #999);
  white-space: pre-wrap;
}
.wish-card__actions {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex-shrink: 0;
  margin-left: 12px;
}
.wish-card__actions button {
  padding: 4px 10px;
  font-size: 12px;
  border: 1px solid var(--border, #ddd);
  border-radius: 6px;
  cursor: pointer;
  background: var(--btn-bg, #f5f5f5);
  color: var(--text, #333);
  white-space: nowrap;
}
.wish-card__actions .btn-convert {
  border-color: var(--accent, #e67e22);
  color: var(--accent, #e67e22);
}
.wish-card__actions .btn-delete {
  border-color: #e74c3c;
  color: #e74c3c;
}

/* form sheet */
.wish-form-container {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.wish-form-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.35);
}
.wish-form-sheet {
  position: relative;
  width: 100%;
  max-width: 420px;
  background: var(--bg, #fff);
  border-radius: 16px 16px 0 0;
  padding: 20px 20px env(safe-area-inset-bottom, 20px);
  box-shadow: 0 -4px 20px rgba(0,0,0,.12);
  z-index: 1;
}
.wish-form-sheet h3 {
  margin: 0 0 16px;
  font-size: 18px;
  text-align: center;
}
.wish-form-sheet label {
  display: block;
  margin-bottom: 12px;
  font-size: 14px;
  color: var(--text-muted, #666);
}
.wish-form-sheet input,
.wish-form-sheet textarea {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 10px 12px;
  font-size: 15px;
  border: 1px solid var(--border, #ddd);
  border-radius: 8px;
  box-sizing: border-box;
  background: var(--input-bg, #fafafa);
}
.wish-form-sheet textarea { resize: vertical; }
.wish-form-actions {
  display: flex;
  gap: 10px;
  margin-top: 16px;
}
.wish-form-actions button {
  flex: 1;
  padding: 10px 0;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  cursor: pointer;
}
.btn-cancel {
  background: var(--btn-secondary-bg, #eee);
  color: var(--text, #333);
}
.btn-submit {
  background: var(--accent, #e67e22);
  color: #fff;
}

/* 07_settings.html */
#settings-placeholder .settings-page {
  padding: 20px;
  max-width: 800px;
  margin: 0 auto;
}
#settings-placeholder .settings-page > h2 {
  font-size: 24px;
  margin-bottom: 24px;
  color: var(--text-primary, #1a1a2e);
}
#settings-placeholder .settings-section {
  background: var(--card-bg, #fff);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}
#settings-placeholder .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
#settings-placeholder .section-header h3 {
  font-size: 18px;
  margin: 0;
  color: var(--text-primary, #1a1a2e);
}
#settings-placeholder .section-desc {
  font-size: 14px;
  color: var(--text-secondary, #666);
  margin: 0 0 12px 0;
}
#settings-placeholder .hint-text {
  font-size: 12px;
  color: var(--text-muted, #999);
  margin: 6px 0 0 0;
}

/* Buttons */
#settings-placeholder .btn {
  padding: 8px 16px;
  border: 1px solid var(--border, #ddd);
  border-radius: 6px;
  background: var(--btn-bg, #f5f5f5);
  color: var(--text-primary, #333);
  cursor: pointer;
  font-size: 14px;
  transition: background 0.2s;
}
#settings-placeholder .btn:hover {
  background: var(--btn-hover, #e8e8e8);
}
#settings-placeholder .btn-primary {
  background: var(--accent, #6c63ff);
  color: #fff;
  border-color: var(--accent, #6c63ff);
}
#settings-placeholder .btn-primary:hover {
  opacity: 0.9;
}
#settings-placeholder .btn-danger {
  background: #e74c3c;
  color: #fff;
  border-color: #e74c3c;
}
#settings-placeholder .btn-danger:hover {
  opacity: 0.9;
}
#settings-placeholder .btn-sm {
  padding: 5px 12px;
  font-size: 13px;
}
#settings-placeholder .btn-close {
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
  color: var(--text-secondary, #666);
  padding: 0 4px;
}

/* Category Grid */
#settings-placeholder .category-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
#settings-placeholder .category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: 8px;
  background: var(--item-bg, #f9f9f9);
  border: 1px solid var(--border-light, #eee);
  transition: background 0.15s;
}
#settings-placeholder .category-card:hover {
  background: var(--item-hover, #f0f0f0);
}
#settings-placeholder .category-card .cat-info {
  display: flex;
  align-items: center;
  gap: 10px;
}
#settings-placeholder .category-card .cat-icon {
  font-size: 20px;
  width: 28px;
  text-align: center;
}
#settings-placeholder .category-card .cat-name {
  font-weight: 500;
  color: var(--text-primary, #333);
}
#settings-placeholder .category-card .cat-path {
  font-size: 12px;
  color: var(--text-muted, #999);
  margin-left: 8px;
}
#settings-placeholder .category-card .cat-actions {
  display: flex;
  gap: 6px;
}
#settings-placeholder .subcategory-indent {
  margin-left: 32px;
}
#settings-placeholder .category-card .btn-icon {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 16px;
  padding: 4px 6px;
  border-radius: 4px;
  color: var(--text-secondary, #888);
  transition: background 0.15s;
}
#settings-placeholder .category-card .btn-icon:hover {
  background: rgba(0,0,0,0.06);
}
#settings-placeholder .category-card .btn-icon.danger:hover {
  background: rgba(231,76,60,0.12);
  color: #e74c3c;
}

/* Channel List */
#settings-placeholder .channel-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
#settings-placeholder .channel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  border-radius: 8px;
  background: var(--item-bg, #f9f9f9);
  border: 1px solid var(--border-light, #eee);
}
#settings-placeholder .channel-row .ch-name {
  font-weight: 500;
  color: var(--text-primary, #333);
}
#settings-placeholder .channel-row .ch-preset-badge {
  font-size: 11px;
  background: var(--accent-light, #e8e6ff);
  color: var(--accent, #6c63ff);
  padding: 2px 8px;
  border-radius: 10px;
  margin-left: 8px;
}
#settings-placeholder .preset-disabled {
  opacity: 0.5;
  cursor: not-allowed !important;
}

/* Toggle */
#settings-placeholder .toggle-row {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  user-select: none;
}
#settings-placeholder .toggle-row input[type="checkbox"] {
  display: none;
}
#settings-placeholder .toggle-slider {
  position: relative;
  width: 44px;
  height: 24px;
  background: var(--toggle-off, #ccc);
  border-radius: 12px;
  transition: background 0.25s;
}
#settings-placeholder .toggle-slider::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.25s;
}
#settings-placeholder .toggle-row input:checked + .toggle-slider {
  background: var(--accent, #6c63ff);
}
#settings-placeholder .toggle-row input:checked + .toggle-slider::after {
  transform: translateX(20px);
}

/* Dialog */
#settings-placeholder .dialog-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
#settings-placeholder .dialog {
  background: var(--card-bg, #fff);
  border-radius: 12px;
  padding: 0;
  min-width: 360px;
  max-width: 480px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
#settings-placeholder .dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border, #eee);
}
#settings-placeholder .dialog-header h4 {
  margin: 0;
  font-size: 16px;
}
#settings-placeholder .dialog-body {
  padding: 20px;
}
#settings-placeholder .dialog-body label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 14px;
  color: var(--text-primary, #333);
}
#settings-placeholder .dialog-body input[type="text"],
#settings-placeholder .dialog-body select {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 8px 12px;
  border: 1px solid var(--border, #ddd);
  border-radius: 6px;
  font-size: 14px;
  background: var(--input-bg, #fff);
  color: var(--text-primary, #333);
  box-sizing: border-box;
}
#settings-placeholder .dialog-body input:focus,
#settings-placeholder .dialog-body select:focus {
  outline: none;
  border-color: var(--accent, #6c63ff);
}
#settings-placeholder .dialog-body p {
  margin: 0 0 12px 0;
  font-size: 14px;
  color: var(--text-primary, #333);
}
#settings-placeholder .dialog-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 20px;
  border-top: 1px solid var(--border, #eee);
}
#settings-placeholder .form-error {
  font-size: 13px;
  color: #e74c3c;
  margin-top: 8px;
}
#settings-placeholder .export-status {
  margin-left: 12px;
  font-size: 13px;
  color: var(--text-secondary, #666);
}
#settings-placeholder .about-info p {
  margin: 4px 0;
  font-size: 14px;
  color: var(--text-primary, #333);
}
#settings-placeholder .loading-spinner {
  padding: 20px;
  text-align: center;
  color: var(--text-muted, #999);
}
</style>
</head>
<body>
<div id="app">
  <!-- Tab Bar -->
  <div class="tab-bar">
    <button v-for="tab in tabs" :key="tab.id" class="tab-item" :class="{active: activeTab === tab.id}" @click="activeTab = tab.id">
      <span class="tab-icon">{{ tab.icon }}</span>
      <span class="tab-label">{{ tab.label }}</span>
    </button>
  </div>

  <!-- Tab Content -->
  <div v-show="activeTab === 'assets'" id="tab-assets">
    <div class="page-header">
      <h1>资产</h1>
      <div class="header-actions">
        <button style="font-size:24px;background:none;border:none;color:var(--primary);cursor:pointer;padding:4px" @click="openAssetForm()">+</button>
      </div>
    </div>
    <div class="search-bar">
      <span class="search-icon">🔍</span>
      <input type="search" v-model="searchQuery" placeholder="搜索资产..." @input="searchAssets">
    </div>
    <!-- 列表将由 assets 组件填充 -->
    <div id="assets-list-placeholder"></div>
  </div>

  <div v-show="activeTab === 'stats'" id="tab-stats">
    <div class="page-header"><h1>统计</h1></div>
    <div id="stats-placeholder"></div>
  </div>

  <div v-show="activeTab === 'wishes'" id="tab-wishes">
    <div class="page-header">
      <h1>心愿</h1>
      <div class="header-actions">
        <button style="font-size:24px;background:none;border:none;color:var(--primary);cursor:pointer;padding:4px" @click="openWishForm()">+</button>
      </div>
    </div>
    <div id="wishes-placeholder"></div>
  </div>

  <div v-show="activeTab === 'settings'" id="tab-settings">
    <div class="page-header"><h1>设置</h1></div>
    <div id="settings-placeholder"></div>
  </div>

  <!-- Asset Detail View -->
  <div v-if="showDetail" class="detail-view" id="detail-view">
    <div class="detail-header">
      <button class="detail-back" @click="closeDetail">←</button>
      <span class="detail-title" id="detail-title">{{ detailAsset?.name }}</span>
    </div>
    <div id="detail-placeholder"></div>
  </div>

  <!-- Bottom Sheet Form (Asset) -->
  <template v-if="showAssetForm">
    <div class="sheet-overlay" @click="showAssetForm = false"></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <h2>{{ editingAssetId ? '编辑资产' : '新建资产' }}</h2>
      <div id="asset-form-placeholder"></div>
    </div>
  </template>

  <!-- Bottom Sheet Form (Wish) -->
  <template v-if="showWishForm">
    <div class="sheet-overlay" @click="showWishForm = false"></div>
    <div class="sheet">
      <div class="sheet-handle"></div>
      <h2>新建心愿</h2>
      <div id="wish-form-placeholder"></div>
    </div>
  </template>
</div>



<script>
